<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  ShipTrack style rules: small on purpose. They catch real mistakes and enforce the naming table
  from the project doc, without fighting over formatting.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>

    <module name="FileTabCharacter"/>
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf_cr_crlf"/>
    </module>
    <module name="LineLength">
        <property name="max" value="140"/>
        <property name="ignorePattern" value="^(package|import) .*"/>
    </module>

    <module name="TreeWalker">
        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- Naming (classes PascalCase, methods camelCase, constants UPPER_SNAKE) -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="ConstantName">
            <property name="format" value="^(log|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="PackageName">
            <property name="format" value="^com\.shiptrack(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- Real bugs -->
        <module name="EqualsHashCode"/>
        <module name="EmptyStatement"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="OneStatementPerLine"/>
        <module name="NeedBraces"/>
        <module name="StringLiteralEquality"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="UpperEll"/>
        <module name="ModifierOrder"/>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>

        <!-- Coding rule: constructor injection, never field @Autowired (tests may use it). -->
        <module name="SuppressionXpathSingleFilter">
            <property name="files" value="[\\/]src[\\/]test[\\/]"/>
            <property name="checks" value="RegexpSinglelineJava"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="^\s*@Autowired\s*$"/>
            <property name="message" value="Use constructor injection instead of field @Autowired"/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
