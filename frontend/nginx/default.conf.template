# ShipTrack web: serves the Angular app and forwards API/docs calls to the gateway on the same origin,
# so the browser never needs CORS. ${API_GATEWAY} is filled in from the environment at container start.
# Behind CloudFront the browser used https, but CloudFront reaches us over http. CloudFront tells us via
# CloudFront-Forwarded-Proto, and we pass that on so the backend (e.g. Swagger links) uses https too.
map $http_cloudfront_forwarded_proto $fwd_proto {
    default $scheme;
    https   https;
}
map $fwd_proto $fwd_port {
    https   443;
    default $server_port;
}
# Tell browsers to stay on https, but only when they actually came in over https.
map $fwd_proto $hsts {
    https   "max-age=31536000";
    default "";
}
# The visitor's address. Behind CloudFront $remote_addr is only the edge server, so limits would be shared by everyone.
map $http_cloudfront_viewer_address $client_ip {
    default $remote_addr;
    "~^(?<viewer_ip>.+):[0-9]+$" $viewer_ip;
}
# Login and sign-up are limited to slow password guessing, and because each attempt runs a deliberately slow BCrypt hash.
limit_req_zone $client_ip zone=auth:10m rate=10r/m;
# Tracking codes are sequential; this makes walking through them impractical.
limit_req_zone $client_ip zone=tracking:10m rate=120r/m;
limit_req_status 429;

server {
    listen 80;
    server_tokens off;
    root /usr/share/nginx/html;

    # Docker's DNS, so nginx starts even if the gateway isn't up yet (it's resolved per request).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $gateway http://${API_GATEWAY};

    # Shared by every proxied location below.
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $fwd_port;
    proxy_read_timeout 30s;
    client_max_body_size 1m;

    # Same JSON shape as every other API error, so the web app can show the message.
    error_page 429 @too_many_requests;
    location @too_many_requests {
        internal;
        default_type application/json;
        return 429 '{"status":429,"error":"TOO_MANY_REQUESTS","message":"Too many attempts. Wait a minute and try again."}';
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Regex locations are tried in order, so the rate-limited paths come before the general API rule.
    location ~ ^/api/v1/auth/(login|register)$ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass $gateway;
    }
    location ~ ^/api/v1/public/ {
        limit_req zone=tracking burst=30 nodelay;
        proxy_pass $gateway;
    }

    # API, Swagger and gateway health -> gateway (path passed through unchanged).
    location ~ ^/(api|docs|v3/api-docs|swagger-ui|actuator)(/|$) {
        proxy_pass $gateway;
    }
    location = /swagger-ui.html {
        proxy_pass $gateway;
    }

    # Hashed build files never change: cache them for a year.
    location ~* \.(?:js|css|woff2?|ico|png|svg)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # The app itself (Angular routes fall back to index.html). Strict security headers apply here only,
    # so the proxied Swagger UI keeps working.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
        add_header Strict-Transport-Security $hsts always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri $uri/ /index.html;
    }
}
