{
  "info": {
    "name": "ShipTrack",
    "description": "ShipTrack v1 API. Run 'Register' then 'Login'; the token is saved automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "authUrl", "value": "http://localhost:8081" },
    { "key": "email", "value": "" },
    { "key": "token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "pm.collectionVariables.set('email', `customer-${Date.now()}@example.com`);"
              ] }
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('201 Created', () => pm.response.to.have.status(201));",
                "pm.test('role is CUSTOMER', () => pm.expect(pm.response.json().role).to.eql('CUSTOMER'));",
                "pm.test('no password in response', () => pm.expect(pm.response.json()).to.not.have.property('passwordHash'));"
              ] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{authUrl}}/api/v1/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"S3cure-pass!\",\n  \"fullName\": \"Ali Khan\"\n}" }
          }
        },
        {
          "name": "Register duplicate (409)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                "pm.test('error code', () => pm.expect(pm.response.json().error).to.eql('EMAIL_ALREADY_REGISTERED'));"
              ] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{authUrl}}/api/v1/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"S3cure-pass!\",\n  \"fullName\": \"Ali Khan\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('has token', () => pm.expect(body.accessToken).to.be.a('string'));",
                "pm.collectionVariables.set('token', body.accessToken);"
              ] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{authUrl}}/api/v1/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"S3cure-pass!\"\n}" }
          }
        },
        {
          "name": "Login wrong password (401)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                "pm.test('error code', () => pm.expect(pm.response.json().error).to.eql('INVALID_CREDENTIALS'));"
              ] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{authUrl}}/api/v1/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "pm.test('is me', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email')));"
              ] }
            }
          ],
          "request": { "method": "GET", "url": "{{authUrl}}/api/v1/users/me" }
        },
        {
          "name": "Me without token (401)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
              ] }
            }
          ],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{authUrl}}/api/v1/users/me" }
        },
        {
          "name": "Create driver as customer (403)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{authUrl}}/api/v1/users",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"driver-x@example.com\",\n  \"password\": \"Dr1ver-pass!\",\n  \"fullName\": \"Bilal Ahmed\",\n  \"role\": \"DRIVER\"\n}" }
          }
        }
      ]
    }
  ]
}
