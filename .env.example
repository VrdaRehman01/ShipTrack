# Copy to .env (git-ignored) and change the values:  cp .env.example .env
# These are FAKE example values. Never commit a real .env.
# Keep comments on their own line: Spring reads this file as .properties,
# so "KEY=value  # note" would make the note part of the value.

# --- MySQL (Docker Compose) ---
MYSQL_ROOT_PASSWORD=change-me-root
# Host port for MySQL. Use 3307 if you already run MySQL locally (and set DB_PORT=3307 too).
MYSQL_HOST_PORT=3306

# --- Shared by all services ---
# localhost when running a service from the IDE; Compose overrides it to "mysql" in containers.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=shiptrack
DB_PASSWORD=change-me-app

# --- JWT (shared by every service that checks tokens) ---
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRATION=15m
# Someone actively using the app keeps getting fresh tokens for this long after logging in.
JWT_MAX_SESSION=8h

# --- Service-to-service key for /internal/** calls (shipment -> billing). Never sent by browsers.
# Generate one with:  openssl rand -hex 32
INTERNAL_API_KEY=replace-with-a-long-random-internal-key

# --- Billing ---
PRICING_CURRENCY=PKR
PRICING_BASE_FEE=250.00
PRICING_PER_KG_RATE=120.00
# How often shipment-service retries invoices that failed while billing was down.
BILLING_RETRY_INTERVAL=60s

# --- Gateway ---
# Comma-separated browser origins allowed to call the API (the Angular website).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- First admin account (optional; created on auth-service startup) ---
ADMIN_EMAIL=admin@shiptrack.local
ADMIN_PASSWORD=change-me-admin
